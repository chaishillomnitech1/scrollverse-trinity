# ─── SUBSCRIPTION PRICING ───────────────────────────────────
STRIPE_PRICE_MONTHLY=price_monthly_999
STRIPE_PRICE_ANNUAL=price_annual_9999
SUBSCRIPTION_MONTHLY_AMOUNT=999
SUBSCRIPTION_ANNUAL_AMOUNT=9999

# ─── DATABASE (MySQL Master-Master Replication) ──────────────
DB_HOST_PRIMARY=localhost
DB_HOST_REPLICA=localhost
DB_PORT=3306
DB_NAME=scrollverse_sovereign
DB_USER=scrollverse_admin
DB_PASSWORD=your_secure_db_password
DB_POOL_MAX=100
DB_POOL_MIN=10

# ─── REDIS CACHE ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_TTL=3600

# ─── MAILCHIMP AUTOMATION ───────────────────────────────────
MAILCHIMP_API_KEY=your_mailchimp_api_key
MAILCHIMP_SERVER_PREFIX=us1
MAILCHIMP_LIST_ID=your_audience_list_id
MAILCHIMP_WELCOME_TEMPLATE_ID=your_welcome_template_id
MAILCHIMP_PAYMENT_CONFIRM_TEMPLATE_ID=your_payment_confirm_template_id
MAILCHIMP_ZAKAT_TEMPLATE_ID=your_zakat_template_id
MAILCHIMP_REFERRAL_TEMPLATE_ID=your_referral_template_id

# ─── JWT AUTH ────────────────────────────────────────────────
JWT_SECRET=your_super_secure_jwt_secret_min_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=30d

# ─── SERVER CONFIG ───────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_VERSION=v3
BASE_URL=https://api.scrollverse.app
FRONTEND_URL=https://scrollverse.app
ALLOWED_ORIGINS=https://scrollverse.app,https://app.scrollverse.app

# ─── SENTRY MONITORING ───────────────────────────────────────
SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── PROMETHEUS METRICS ──────────────────────────────────────
METRICS_PORT=9090
METRICS_PATH=/metrics

# ─── RATE LIMITING ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_PAYMENT_MAX=10

# ─── ZAKAT DISTRIBUTION ──────────────────────────────────────
ZAKAT_RATE_MIN=0.0777
ZAKAT_RATE_MAX=0.15
ZAKAT_WALLET_ADDRESS=your_zakat_wallet_address
ZAKAT_AUTO_DISTRIBUTE=true

# ─── REFERRAL SYSTEM ─────────────────────────────────────────
REFERRAL_REWARD_AMOUNT=500
REFERRAL_REWARD_CURRENCY=usd
REFERRAL_VIRAL_COEFFICIENT=1.18

# ─── BLOCKCHAIN ──────────────────────────────────────────────
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your_infura_key
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/your_infura_key
ARBITRUM_RPC_URL=https://arbitrum-mainnet.infura.io/v3/your_infura_key
PRIVATE_KEY=your_wallet_private_key

# ─── CLOUDFLARE CDN ──────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_zone_id

# ─── LOGGING ─────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=logs/scrollverse.log
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
