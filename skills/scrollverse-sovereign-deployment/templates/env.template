# ─── STRIPE (LIVE MODE) ─────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_FILL_IN_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_FILL_IN_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_FILL_IN_FROM_STRIPE_DASHBOARD_WEBHOOKS
STRIPE_ACCOUNT_ID=FILL_IN_YOUR_STRIPE_ACCOUNT_ID
STRIPE_PRICE_ID=price_FILL_IN_YOUR_SUBSCRIPTION_PRICE_ID

# ─── DATABASE ───────────────────────────────────────────────
DB_HOST=mysql-primary
DB_HOST_REPLICA=mysql-replica
DB_PORT=3306
DB_NAME=scrollverse_sovereign
DB_USER=scrollverse_admin
DB_PASSWORD=FILL_IN_RUN_generate_secrets.py
DB_ROOT_PASSWORD=FILL_IN_RUN_generate_secrets.py
DB_POOL_MAX=100
DB_POOL_MIN=10

# ─── REDIS CACHE ────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=FILL_IN_RUN_generate_secrets.py
REDIS_TTL=3600

# ─── MAILCHIMP AUTOMATION ───────────────────────────────────
# Get from: mailchimp.com → Account → Extras → API Keys
MAILCHIMP_API_KEY=FILL_IN_FROM_MAILCHIMP_ACCOUNT_API_KEYS
# Get from: your Mailchimp URL prefix (e.g. us14)
MAILCHIMP_SERVER_PREFIX=us1
# Get from: Mailchimp → Audience → Settings → Audience ID
MAILCHIMP_LIST_ID=FILL_IN_FROM_MAILCHIMP_AUDIENCE_SETTINGS

# ─── JWT AUTH ────────────────────────────────────────────────
JWT_SECRET=FILL_IN_RUN_generate_secrets.py
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=FILL_IN_RUN_generate_secrets.py
JWT_REFRESH_EXPIRES_IN=30d

# ─── MONITORING ──────────────────────────────────────────────
# Get from: sentry.io → Project Settings → Client Keys → DSN
SENTRY_DSN=FILL_IN_FROM_SENTRY_PROJECT_SETTINGS
GRAFANA_PASSWORD=scrollverse_grafana

# ─── SERVER CONFIG ───────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_URL=https://api.scrollverse.app
FRONTEND_URL=https://scrollverse.app
ALLOWED_ORIGINS=https://scrollverse.app,https://www.scrollverse.app

# ─── SCROLLVERSE SOVEREIGN ECONOMICS ────────────────────────
ZAKAT_RATE=0.0777
REFERRAL_COEFFICIENT=1.18
SUBSCRIPTION_PRICE=9.99
